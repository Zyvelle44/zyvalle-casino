# Copy this file to .env and replace every placeholder before starting the API.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=zyvalle_bet
DATABASE_USER=zyvalle_app
DATABASE_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Used only by `npm run seed:admin`; do not reuse a production account password.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@zyvalle.local
ADMIN_PASSWORD=
